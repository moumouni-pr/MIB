---
layout: base.njk
---
{% from "macros.njk" import visuel, carte %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ title | json | safe }},
  "description": {{ resume | json | safe }},
  "category": {{ categorie | json | safe }},
  {% if image %}"image": [{{ (image | absolute(site.url)) | json | safe }}{% for g in galerie %}, {{ (g | absolute(site.url)) | json | safe }}{% endfor %}],{% endif %}
  "brand": { "@type": "Brand", "name": {{ (marque or site.nom) | json | safe }} },
  "offers": {
    "@type": "Offer",
    "price": "{{ prix }}",
    "priceCurrency": "{{ site.devise_iso }}",
    "availability": "https://schema.org/{{ 'InStock' if en_stock != false else 'OutOfStock' }}",
    "url": "{{ page.url | absolute(site.url) }}",
    "seller": { "@id": "{{ site.url }}/#boutique" }
  }
}
</script>
<section class="product">
  <div class="wrap">
    <nav class="crumbs"><a href="/">Accueil</a> / <a href="/boutique/">Boutique</a> / <span>{{ title }}</span></nav>
    <div class="product-grid">
      <div class="gallery">
        <div class="product-img">
          {% set rm = prix | remise(ancien_prix) %}
          {% if rm %}<span class="badge promo">-{{ rm }}%</span>{% elif badge %}<span class="badge">{{ badge }}</span>{% endif %}
          {% if image %}<img src="{{ image }}" alt="{{ title }}" id="mainPhoto">{% else %}{{ visuel({ image: image, icone: icone }, title) }}{% endif %}
        </div>
        {% if image and galerie and galerie.length %}
        <div class="thumbs" id="thumbs">
          {% for g in [image].concat(galerie) %}<button type="button" class="{{ 'on' if loop.first }}" data-src="{{ g }}"><img src="{{ g }}" alt="{{ title }} — photo {{ loop.index }}" loading="lazy"></button>{% endfor %}
        </div>
        {% endif %}
      </div>
      <div>
        <span class="cat">{{ categorie }}</span>
        <h1 class="product-title">{{ title }}</h1>
        <div class="product-price">{{ prix | prix(site.devise) }}{% if ancien_prix %}<span class="old">{{ ancien_prix | prix(site.devise) }}</span>{% endif %}</div>
        <p class="stock {{ 'no' if en_stock == false }}">{{ 'En stock' if en_stock != false else 'Rupture de stock — contactez-nous' }}</p>
        <p class="sub">{{ resume }}</p>
        {% if couleurs and couleurs.length %}
        <div class="variants">
          <p>Couleur : <b id="couleurChoisie">{{ couleurs[0].nom }}</b></p>
          <div class="swatches" id="swatches">
            {% for c in couleurs %}<button type="button" class="{{ 'on' if loop.first }}" data-couleur="{{ c.nom }}" data-img="{{ c.image }}" title="{{ c.nom }}">{% if c.image %}<img src="{{ c.image }}" alt="{{ title }} {{ c.nom }}" loading="lazy">{% endif %}<span>{{ c.nom }}</span></button>{% endfor %}
          </div>
        </div>
        {% endif %}
        <div class="btns" style="margin:24px 0">
          {% if en_stock != false %}<button type="button" class="btn btn-dark" id="btnAjout" {% if couleurs and couleurs.length %}data-couleur="{{ couleurs[0].nom }}"{% endif %} onclick="addToCart('{{ page.fileSlug }}', this.dataset.couleur); openCart()">Ajouter au panier</button>{% endif %}
          {% set waBase %}https://wa.me/{{ site.whatsapp }}?text={{ ('Bonjour ' + site.nom + ', je suis intéressé(e) par : ' + title + ' (' + (prix | prix(site.devise)) + ')') | urlencode }}{% endset %}
          <a class="btn btn-wa" id="btnWa" target="_blank" rel="noopener" data-base="{{ waBase }}" href="{{ waBase }}{% if couleurs and couleurs.length %}{{ (' — couleur : ' + couleurs[0].nom) | urlencode }}{% endif %}">Commander sur WhatsApp</a>
        </div>
        <div class="prose">{{ content | safe }}</div>
      </div>
    </div>
  </div>
</section>
{% set similaires = [] %}
{% for p in collections.produits %}{% if p.url != page.url and similaires.length < 5 %}{% set similaires = (similaires.push(p), similaires) %}{% endif %}{% endfor %}
{% if similaires.length %}
<section class="mk-sec last">
  <div class="wrap">
    <div class="mk-box">
      <div class="mk-head"><h2>Vous aimerez aussi</h2><a href="/boutique/">Voir la boutique →</a></div>
      <div class="grid g5">{% for p in similaires %}{{ carte(p, site) }}{% endfor %}</div>
    </div>
  </div>
</section>
{% endif %}
