{% macro icone(nom) -%}
{%- if nom == "portable" -%}<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="4" y="18" width="12" height="28" rx="5"/><rect x="48" y="18" width="12" height="28" rx="5"/><rect x="16" y="18" width="32" height="28" rx="1"/><circle cx="10" cy="27" r="2" fill="currentColor"/><circle cx="54" cy="37" r="2" fill="currentColor"/></svg>
{%- elif nom == "manette" -%}<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 16h28c8 0 14 7 13 15l-2 13c-1 6-8 8-12 3l-5-6H24l-5 6c-4 5-11 3-12-3L5 31c-1-8 5-15 13-15z"/><path d="M20 26v10M15 31h10"/><circle cx="44" cy="27" r="2" fill="currentColor"/><circle cx="48" cy="33" r="2" fill="currentColor"/></svg>
{%- elif nom == "casque" -%}<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M10 38v-6a22 22 0 0 1 44 0v6"/><rect x="6" y="36" width="12" height="18" rx="4"/><rect x="46" y="36" width="12" height="18" rx="4"/></svg>
{%- elif nom == "jeu" -%}<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="14" y="6" width="36" height="52" rx="4"/><path d="M14 16h36"/><path d="M26 30l12 7-12 7z"/></svg>
{%- elif nom == "carte" -%}<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="6" y="16" width="52" height="34" rx="5"/><path d="M6 26h52"/><path d="M14 40h14"/></svg>
{%- else -%}<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="22" y="6" width="20" height="52" rx="6"/><path d="M32 14v10"/><circle cx="32" cy="48" r="2" fill="currentColor"/></svg>
{%- endif -%}
{%- endmacro %}

{% macro visuel(p, alt) -%}
{%- if p.image -%}<img src="{{ p.image }}" alt="{{ alt }}" loading="lazy">{%- else -%}{{ icone(p.icone) }}{%- endif -%}
{%- endmacro %}

{% macro carte(p, site) -%}
<article class="card" data-cat="{{ p.data.categorie }}">
  <a href="{{ p.url }}" class="thumb">
    {% if p.data.badge %}<span class="badge {{ 'promo' if p.data.badge == 'Promo' }}">{{ p.data.badge }}</span>{% endif %}
    {% if p.data.en_stock == false %}<span class="badge out">Rupture</span>{% endif %}
    {{ visuel(p.data, p.data.title) }}
  </a>
  <div class="body">
    <span class="cat">{{ p.data.categorie }}</span>
    <h3><a href="{{ p.url }}">{{ p.data.title }}</a></h3>
    <p class="desc">{{ p.data.resume }}</p>
    <div class="row">
      <div class="price">{{ p.data.prix | prix(site.devise) }}{% if p.data.ancien_prix %}<span class="old">{{ p.data.ancien_prix | prix(site.devise) }}</span>{% endif %}</div>
      {% if p.data.en_stock != false %}
      <button class="add" type="button" onclick="addToCart('{{ p.fileSlug }}')" aria-label="Ajouter {{ p.data.title }} au panier">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
      </button>
      {% endif %}
    </div>
  </div>
</article>
{%- endmacro %}

{% macro articleCarte(a) -%}
<a href="{{ a.url }}" class="post">
  <div class="post-img">{% if a.data.image %}<img src="{{ a.data.image }}" alt="{{ a.data.title }}" loading="lazy">{% else %}<img src="/assets/img/logo-wide.png" alt="" class="post-logo">{% endif %}</div>
  <div class="post-body">
    <time datetime="{{ a.date | isoDate }}">{{ a.date | dateFr }}</time>
    <h3>{{ a.data.title }}</h3>
    <p>{{ a.data.resume }}</p>
    <span class="more">Lire l'article →</span>
  </div>
</a>
{%- endmacro %}
