---
layout: base.njk
---
{% from "macros.njk" import carte, articleCarte, icone %}
{% set cats = collections.produits | categories %}
{% set icCat = { "Consoles": "console", "Accessoires": "manette", "Jeux": "jeu", "Cartes cadeaux": "carte", "PC Gaming": "casque", "Occasion": "portable" } %}

<section class="mk-hero">
  <div class="wrap mk-hero-grid">
    <aside class="mk-side">
      <h3>Catégories</h3>
      {% for c in cats %}
      <a href="/boutique/?cat={{ c | urlencode }}"><span class="mk-side-ic">{{ icone(icCat[c] or "console") }}</span>{{ c }}<small>{{ collections.produits | compte(c) }}</small></a>
      {% endfor %}
      {% if (collections.produits | promos).length %}<a href="/boutique/?cat=promo" class="hot"><span class="mk-side-ic">🔥</span>Promos<small>{{ (collections.produits | promos).length }}</small></a>{% endif %}
    </aside>

    <div class="slider" id="slider">
      {% for b in site.bannieres %}
      <div class="slide s-{{ b.style or 'bleu' }} {{ 'on' if loop.first }}">
        <div class="slide-txt">
          {% if b.etiquette %}<span class="slide-tag">{{ b.etiquette }}</span>{% endif %}
          <{{ 'h1' if loop.first else 'h2' }} class="slide-title">{{ b.titre }}</{{ 'h1' if loop.first else 'h2' }}>
          <p>{{ b.texte }}</p>
          <a href="{{ b.lien }}" class="btn btn-white">{{ b.bouton }} →</a>
        </div>
        {% if b.image %}<img src="{{ b.image }}" alt="" class="slide-img">{% else %}<img src="/assets/img/logo-white.png" alt="" class="slide-logo">{% endif %}
      </div>
      {% endfor %}
      <div class="dots">{% for b in site.bannieres %}<button type="button" class="{{ 'on' if loop.first }}" aria-label="Bannière {{ loop.index }}"></button>{% endfor %}</div>
    </div>

    <div class="mk-right">
      <div class="mk-welcome">
        <img src="/assets/img/logo.png" alt="Logo {{ site.nom }}" width="64" height="64">
        <div><b>Bienvenue chez {{ site.nom }}</b><small>{{ site.slogan }}</small></div>
      </div>
      {% set promo = (collections.produits | promos)[0] or collections.produits[0] %}
      {% if promo %}
      {% set rmp = promo.data.prix | remise(promo.data.ancien_prix) %}
      <a href="{{ promo.url }}" class="mk-deal">
        {% if rmp %}<span class="badge promo">-{{ rmp }}%</span>{% endif %}
        <div class="mk-deal-ic">{% if promo.data.image %}<img src="{{ promo.data.image }}" alt="{{ promo.data.title }}">{% else %}{{ icone(promo.data.icone) }}{% endif %}</div>
        <div><small>{{ "Offre du moment" if rmp else "À la une" }}</small><b>{{ promo.data.title }}</b><span class="price">{{ promo.data.prix | prix(site.devise) }}</span></div>
      </a>
      {% endif %}
      <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener" class="mk-help">
        <b>Besoin d'un conseil ?</b><small>Écrivez-nous sur WhatsApp, réponse rapide</small>
      </a>
    </div>
  </div>
</section>

<section class="trust">
  <div class="wrap"><div class="trust-grid">
    <div><span>🚚</span><p><b>Livraison 24h</b><small>à {{ site.ville }}</small></p></div>
    <div><span>✅</span><p><b>100% authentique</b><small>produits neufs garantis</small></p></div>
    <div><span>📱</span><p><b>MyNita & Amana</b><small>ou paiement à la livraison</small></p></div>
    <div><span>💬</span><p><b>Service client</b><small>7j/7 sur WhatsApp</small></p></div>
  </div></div>
</section>

{% set promos = collections.produits | promos %}
{% if promos.length %}
<section class="mk-sec">
  <div class="wrap">
    <div class="mk-box flash">
      <div class="mk-head">
        <h2>🔥 Promos du moment</h2>
        <a href="/boutique/?cat=promo">Tout voir →</a>
      </div>
      <div class="grid g5">{% for p in promos | limit(5) %}{{ carte(p, site) }}{% endfor %}</div>
    </div>
  </div>
</section>
{% endif %}

<section class="mk-sec">
  <div class="wrap">
    <div class="mk-box">
      <div class="mk-head"><h2>Acheter par catégorie</h2></div>
      <div class="cat-tiles">
        {% for c in cats %}
        <a href="/boutique/?cat={{ c | urlencode }}" class="cat-tile"><span>{{ icone(icCat[c] or "console") }}</span><b>{{ c }}</b><small>{{ collections.produits | compte(c) }} produits</small></a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% for c in cats %}
{% set liste = collections.produits | parCategorie(c) %}
<section class="mk-sec">
  <div class="wrap">
    <div class="mk-box">
      <div class="mk-head">
        <h2>{{ c }}</h2>
        <a href="/boutique/?cat={{ c | urlencode }}">Voir tout ({{ liste.length }}) →</a>
      </div>
      <div class="grid g5">{% for p in liste | limit(5) %}{{ carte(p, site) }}{% endfor %}</div>
    </div>
  </div>
</section>
{% endfor %}

{% if site.marques.length %}
<section class="mk-sec">
  <div class="wrap">
    <div class="mk-box">
      <div class="mk-head"><h2>Nos marques</h2></div>
      <div class="brands">{% for m in site.marques %}<a href="/recherche/?q={{ m | urlencode }}">{{ m }}</a>{% endfor %}</div>
    </div>
  </div>
</section>
{% endif %}

{% if collections.articles.length %}
<section class="mk-sec">
  <div class="wrap">
    <div class="mk-box">
      <div class="mk-head"><h2>Actualités gaming</h2><a href="/blog/">Tous les articles →</a></div>
      <div class="posts">{% for a in collections.articles | limit(3) %}{{ articleCarte(a) }}{% endfor %}</div>
    </div>
  </div>
</section>
{% endif %}

<section id="contact" class="mk-sec last">
  <div class="wrap about">
    <div>
      <h2>Venez nous rendre visite</h2>
      <p class="tag" style="margin:14px 0 0">{{ site.horaires }}</p>
      <p class="sub">{{ site.presentation }}</p>
      <div class="btns" style="margin-top:28px">
        <a href="{{ site.lien_carte }}" target="_blank" rel="noopener" class="btn btn-dark">Voir l'itinéraire</a>
        <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener" class="btn btn-wa">WhatsApp</a>
      </div>
    </div>
    <div class="about-box">
      <div><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg><p><small>Adresse</small>{{ (site.adresse + ", ") if site.adresse }}{{ site.ville }}, {{ site.pays }}<br><a href="{{ site.lien_carte }}" target="_blank" rel="noopener" style="text-decoration:underline">Voir sur Google Maps</a></p></div>
      <div><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><p><small>Horaires</small>{{ site.horaires }}</p></div>
      <div><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg><p><small>Téléphone / WhatsApp</small>{{ site.telephone }}</p></div>
    </div>
  </div>
</section>
